# --- Database ---
DATABASE_URL="postgresql://finance:finance_dev_password@localhost:5432/finance_dev"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-dev-only"
JWT_REFRESH_SECRET="replace-me-dev-only"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- 2FA ---
# Key used to encrypt TOTP secrets at rest. Generate with the same command as above.
TWO_FACTOR_ENCRYPTION_KEY="replace-me-dev-only"

# --- Email ---
# "console" (default dev driver): verification/reset links are logged to the API
# console instead of sent, so email-gated flows are testable with no mail server.
# "smtp": sends via the SMTP settings below (e.g. Mailpit if you're on Docker, or
# a real provider in production).
EMAIL_DRIVER="console"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Finance App <no-reply@finance.local>"

# --- File storage (local disk in dev) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./apps/api/uploads"
# STORAGE_DRIVER=s3 in production, with STORAGE_S3_* vars added when that adapter ships

# --- App ---
NODE_ENV="development"
API_PORT="4000"
WEB_PORT="3000"
CORS_ORIGIN="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000"
DEFAULT_CURRENCY="LKR"
